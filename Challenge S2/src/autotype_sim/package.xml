<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autotype_sim</name>
  <version>0.1.0</version>
  <description>URC autonomous-typing challenge simulator: 5-DOF velocity-controlled arm, rendered ArUco camera, browser dashboard.</description>
  <maintainer email="rishav.a.nair@gmail.com">Rishav Nair</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>autotype_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>python3-numpy</depend>
  <depend>python3-yaml</depend>
  <depend>python3-aiohttp</depend>
  <!-- OpenCV is installed from pip (opencv-contrib-python-headless >= 4.7) rather than
       the Ubuntu package, whose 4.6 build lacks the current ArUco API. See docs/INFO.md s.3. -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
